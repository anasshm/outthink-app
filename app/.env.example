# Server-only settings for app/.env.local; never prefix secrets with VITE_.
# Easiest: run `node scripts/configure-server.mjs` from the repo root (see SETUP.md).
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase secret key (sb_secret_...) or legacy service_role key. Server only.
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-6-astra
# Leave empty for models that do not accept a reasoning setting.
AI_REASONING_EFFORT=low
# scrypt salt:hash of your app password, generated by scripts/configure-server.mjs
APP_PASSWORD_HASH=
# The origin you open the app from; your https URL in production.
APP_ORIGIN=http://localhost:5173
